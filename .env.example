# Decarby Solar — optional Supabase backend (Phase 3A)
# Copy to `.env.local` for local development. Leave blank to play fully offline.
#
# Never put the service_role / secret key in Vite env vars or frontend source.
#
# Staging integration uses a SEPARATE file: copy `.env.staging.example` → `.env.staging.local`
# Do not overwrite this production/dev `.env.local` with staging credentials.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# --- Supabase Edge Function secrets only (never VITE_*) ---
# Set via: npx supabase secrets set --remote
# RESEND_API_KEY=
# TRANSACTIONAL_EMAIL_FROM=Decarby Solar <vouchers@your-verified-domain>
# VOUCHER_EMAIL_SEND_DEMO=false
