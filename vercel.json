{
  "functions": {
    "api/staff/*.ts": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/code", "destination": "/code/index.html" },
    { "source": "/code/", "destination": "/code/index.html" },
    { "source": "/voucher-terms", "destination": "/voucher-terms/index.html" },
    { "source": "/voucher-terms/", "destination": "/voucher-terms/index.html" },
    {
      "source": "/((?!api(?:/|$)|code(?:/|$)|voucher-terms(?:/|$)|assets(?:/|$)|favicon\\.svg|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/code",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/code/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/staff/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
