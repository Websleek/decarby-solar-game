# Decarby Solar — STAGING only (Phase 4C.2 / 4C.3 integration)
# Copy to `.env.staging.local` (gitignored). Never copy these into `.env.local`.
#
# Do NOT use the production project ref (lrohmaodpqbmvgxsspql).
# Never put the staging service_role key in VITE_* variables used by the browser build.

# --- Frontend / anon (safe for Vite staging builds) ---
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_PUBLISHABLE_ANON_KEY

# --- Integration harness only (Node scripts; not bundled into Vite) ---
STAGING_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
STAGING_SUPABASE_ANON_KEY=YOUR_STAGING_PUBLISHABLE_ANON_KEY
STAGING_SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY
STAGING_PROJECT_REF=YOUR_STAGING_PROJECT_REF

# Optional: staff operator auth user UUID already present in staging auth.users
# STAGING_OPERATOR_USER_ID=

# Hard refuse if these match production
# PRODUCTION_PROJECT_REF=lrohmaodpqbmvgxsspql

# --- Final B transactional email (Edge secrets; never VITE_*) ---
# RESEND_API_KEY=
# TRANSACTIONAL_EMAIL_FROM=Decarby Solar <vouchers@your-verified-domain>
# VOUCHER_EMAIL_SEND_DEMO=true
